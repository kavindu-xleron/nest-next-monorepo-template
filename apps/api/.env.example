# Copy to .env and adjust. Every variable here is declared in
# src/config/env.schema.ts — the app refuses to boot if one is invalid, and
# anything not declared there is invisible to ConfigService.
#
# Values shown are the schema defaults; commented-out lines are optional.

NODE_ENV=development
PORT=5001

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Shutdown tuning. DRAIN_INTERVAL_MS is how long readiness reports failing
# before connections stop being accepted, giving the load balancer time to
# notice. It must stay below SHUTDOWN_TIMEOUT_MS, which is the deadline for the
# whole sequence — otherwise the process is forced out mid-drain.
DRAIN_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=30000

# Required when NODE_ENV=production. Added in Phase 4.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Added in Phase 6.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
