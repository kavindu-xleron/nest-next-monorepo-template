# Copy to .env.local and fill in. Validated in lib/env.ts — the app refuses to
# build or start if a required value is missing or malformed.

# Clerk. Get these from the Clerk dashboard (API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where the Nest API lives. The client appends /api/v1 itself.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Optional: send users somewhere specific after auth.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
